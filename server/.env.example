PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# Option 1 (Local MongoDB Compass):
MONGODB_URI=mongodb://127.0.0.1:27017/classic_cut_salon
# Option 2 (MongoDB Atlas Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your_cluster.mongodb.net/classic_cut_salon?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=classic_cut_super_secure_jwt_secret_key_2026_luxury_barber

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email OTP Configuration (SMTP)
# Note: In development, if left empty, OTP will be printed directly in the server terminal!
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Default Initial Admin Credentials
ADMIN_EMAIL=admin@classiccut.com
ADMIN_PASSWORD=admin12345
